rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'shreyat1421@gmail.com';
    }
    function isAdmin() { 
      return isSuperAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
      ); 
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      function isValidUser(data) {
        return data.uid is string && data.uid == request.auth.uid &&
               data.email is string && data.email.size() > 0 &&
               data.isAdmin is bool &&
               (data.isAdmin == false || isSuperAdmin());
      }

      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      
      allow update: if (isOwner(userId) && 
                      (incoming().isAdmin == existing().isAdmin || isSuperAdmin()) && 
                      incoming().uid == existing().uid &&
                      incoming().email == existing().email)
                    || 
                    (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isAdmin']));
    }

    // Admin Requests Collection
    match /adminRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && isOwner(resource.data.uid));
      allow create: if isSignedIn() && isOwner(incoming().uid) && incoming().status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Food Items Collection
    match /foodItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      function isValidOrder(data) {
        return data.userId is string && data.userId == request.auth.uid &&
               data.items is list && data.items.size() > 0 &&
               data.totalAmount is number &&
               data.status is string && data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
      }

      allow create: if isSignedIn() && isOwner(incoming().userId) && 
                    isValidOrder(incoming()) &&
                    incoming().status == 'pending';
                    
      allow update: if isAdmin() && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                    incoming().status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
    }
  }
}
